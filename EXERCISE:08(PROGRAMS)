import javax.swing.*;
import java.awt.*;

public class BarChartDemo extends JPanel {

    int[] marks = {78, 91, 45, 65, 85};
    String[] names = {"Aravind", "Divya", "Karthik", "Ravi", "Meena"};

    public BarChartDemo() {
        setPreferredSize(new Dimension(400, 300));
        setBackground(Color.WHITE);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        g.setColor(Color.BLACK);
        g.drawLine(40, 240, 370, 240);

        for (int i = 0; i < marks.length; i++) {
            int x = 55 + i * 65;
            int height = marks[i] * 2;

            g.setColor(Color.BLUE);
            g.fillRect(x, 240 - height, 40, height);

            g.setColor(Color.BLACK);
            g.drawString(String.valueOf(marks[i]), x + 10, 235 - height);
            g.drawString(names[i], x - 5, 260);
        }
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Bar Chart");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.add(new BarChartDemo());
        frame.pack();
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
}
