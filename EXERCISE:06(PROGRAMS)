class InvalidAgeException extends Exception {
    InvalidAgeException(String msg) {
        super(msg);
    }
}

class DailyLimitException extends Exception {
    DailyLimitException(String msg) {
        super(msg);
    }
}

public class BankingDemo {

    static void verify(int age) throws InvalidAgeException {
        if (age < 18) {
            throw new InvalidAgeException("Age " + age + " is below 18");
        }
        System.out.println("Age " + age + " accepted");
    }

    static void checkWithdrawal(double amount) throws DailyLimitException {
        if (amount > 5000) {
            throw new DailyLimitException("Daily limit is Rs. 5000");
        }
        System.out.println("Withdrawal of Rs. " + amount + " successful");
    }

    public static void main(String[] args) {
        try {
            verify(21);
            verify(15);
        } catch (InvalidAgeException e) {
            System.out.println("Rejected : " + e.getMessage());
        }

        try {
            checkWithdrawal(3000);
            checkWithdrawal(6000);
        } catch (DailyLimitException e) {
            System.out.println("Transaction rejected : " + e.getMessage());
        }
    }
}
